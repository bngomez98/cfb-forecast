# Reverse proxy for the dashboard. Caddy provisions TLS automatically for
# public hostnames; CFB_DOMAIN=localhost uses a locally trusted certificate.
{$CFB_DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:8501
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
