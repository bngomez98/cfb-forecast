# Copy to .env to override docker compose defaults. Every value shown is the default.
CFB_FORECAST_SEASON=2026
CFB_FORECAST_DRAWS=50000
CFB_BACKTEST_LEAD_HOURS=48
CFB_REFRESH_DATA=1
# External sources collected by the pipeline: all, none, or a comma-separated list (cfb-forecast sources-list)
CFB_SOURCES=all
CFB_LOG_LEVEL=INFO
# Scheduler (UTC): daily forecast cadence and hour, weekly backtest slot
CFB_FORECAST_HOURS=24
CFB_FORECAST_HOUR=9
CFB_BACKTEST_DAY=tue
CFB_BACKTEST_HOUR=11
# Dated forecast snapshots to keep (artifacts/forecasts); older ones are pruned
CFB_KEEP_FORECASTS=14
CFB_DATA_DIR=./data
CFB_ARTIFACTS_DIR=./artifacts
CFB_IMAGE=cfb-forecast:local
CFB_DASHBOARD_IMAGE=cfb-forecast-dashboard:local
CFB_DASHBOARD_PORT=8501
# Public hostname served by Caddy with automatic HTTPS (only used by the "public" profile).
CFB_DOMAIN=localhost
